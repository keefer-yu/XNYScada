<Window x:Class="XNY.Scada.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:XNY.Scada.Presentation.ViewModels;assembly=XNY.Scada.Presentation"
        xmlns:views="clr-namespace:XNY.Scada.Wpf.Views"
        Title="{Binding Title}" Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource PageBrush}" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlarmViewModel}"><views:AlarmView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductionViewModel}"><views:ProductionView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecipeViewModel}"><views:RecipeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FlowMonitorViewModel}"><views:FlowMonitorView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FlowDesignerViewModel}"><views:FlowDesignerView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceConfigViewModel}"><views:DeviceConfigView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}"><views:DiagnosticsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MesViewModel}"><views:MesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserAdminViewModel}"><views:UserAdminView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditViewModel}"><views:AuditView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemViewModel}"><views:SystemView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid Background="{StaticResource HeaderBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <TextBlock Text="XNY SCADA" Foreground="White" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="{Binding MachineTitle}" Foreground="#A8B4C4" FontSize="14" Margin="16,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="配方：" Foreground="#A8B4C4" />
                <TextBlock Text="{Binding RecipeName}" Foreground="White" Margin="0,0,24,0" />
                <Border CornerRadius="3" Padding="10,3" Background="#E53E3E"
                        Visibility="{Binding ActiveAlarmCount, Converter={StaticResource NotEmptyToVis}}">
                    <Button Background="Transparent" BorderThickness="0" Padding="0" Foreground="White" Cursor="Hand"
                            Command="{Binding NavigateCommand}" CommandParameter="{Binding MenuItems[1]}">
                        <TextBlock Foreground="White">
                            <Run Text="报警" /><Run Text="{Binding ActiveAlarmCount, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding LatestAlarm, Mode=OneWay}" />
                        </TextBlock>
                    </Button>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="{Binding UserDisplay}" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="登录" Command="{Binding ShowLoginCommand}" Style="{StaticResource ButtonPrimary}" Margin="0,0,6,0"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                <Button Content="改密" Command="{Binding ChangePasswordCommand}" Margin="0,0,6,0"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}" />
                <Button Content="登出" Command="{Binding LogoutCommand}" Margin="0,0,12,0"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Now, StringFormat=yyyy-MM-dd HH:mm:ss}" Foreground="#A8B4C4" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="168" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource MenuBrush}">
                <ItemsControl ItemsSource="{Binding MenuItems}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MenuItemViewModel}">
                            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" Height="42" HorizontalContentAlignment="Left"
                                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" Padding="18,0">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#34465E" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuSelectedBrush}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />

            <!-- 流程人工确认（非模态） -->
            <ItemsControl Grid.Column="1" ItemsSource="{Binding PendingConfirmations}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#F0A020" BorderThickness="2" CornerRadius="4" Padding="12" Margin="0,8,0,0" Width="340">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Opacity="0.3" ShadowDepth="2" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,6" />
                                <TextBlock Text="{Binding Deadline, StringFormat=超时时间 HH:mm:ss}" Foreground="Gray" FontSize="11" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="是 / 确认" Command="{Binding YesCommand}" Style="{StaticResource ButtonPrimary}" Margin="0,0,8,0" />
                                    <Button Content="否 / 拒绝" Command="{Binding NoCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="120" Height="6" Margin="8,0" IsIndeterminate="True"
                             Visibility="{Binding CurrentPage.IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" Style="{StaticResource StatusText}" />
                <TextBlock Text="{Binding CurrentPage.StatusMessage}" Style="{StaticResource StatusText}" />
            </DockPanel>
        </Border>

        <!-- 登录遮罩 -->
        <Grid Grid.RowSpan="3" Background="#99000000" Visibility="{Binding IsLoginVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="6" Width="380" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                    DataContext="{Binding Login}">
                <StackPanel>
                    <TextBlock Text="用户登录" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />
                    <TextBlock Text="用户名" Margin="0,0,0,4" />
                    <TextBox x:Name="UserNameBox" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="密码" Margin="0,10,0,4" />
                    <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" KeyDown="OnPasswordKeyDown" />
                    <TextBlock Text="刷卡登录（读卡器输入后回车）" Margin="0,10,0,4" Foreground="Gray" />
                    <TextBox Text="{Binding CardNo, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding CardLoginCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#E53E3E" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVis}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="登录" Command="{Binding LoginCommand}" Style="{StaticResource ButtonPrimary}" MinWidth="90" Margin="0,0,8,0" />
                        <Button Content="取消" Command="{Binding DataContext.CloseLoginCommand, RelativeSource={RelativeSource AncestorType=Window}}" MinWidth="90" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
