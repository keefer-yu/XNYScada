<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>XNY.Scada.Wpf</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\XNY.Scada.Presentation\XNY.Scada.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HandyControl" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\configs\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\configs\machine-templates\*.json" Link="configs\machine-templates\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
