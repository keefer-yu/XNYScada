<UserControl x:Class="XNY.Scada.Wpf.Views.UserAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl Margin="5">
        <TabItem Header="用户">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button Content="新增用户" Command="{Binding NewUserCommand}" Style="{StaticResource ToolButton}" />
                        <Button Content="删除" Command="{Binding DeleteUserCommand}" Style="{StaticResource DangerButton}" />
                        <Button Content="重置密码" Command="{Binding ResetPasswordCommand}" Style="{StaticResource ToolButton}" />
                        <Button Content="解锁" Command="{Binding UnlockCommand}" Style="{StaticResource ToolButton}" />
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" Style="{StaticResource ReadOnlyGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="账号" Binding="{Binding User.UserName}" Width="110" />
                            <DataGridTextColumn Header="姓名" Binding="{Binding User.DisplayName}" Width="110" />
                            <DataGridTextColumn Header="角色" Binding="{Binding RoleNames}" Width="*" />
                            <DataGridTextColumn Header="卡号" Binding="{Binding User.CardNo}" Width="100" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="60" />
                            <DataGridTextColumn Header="最近登录" Binding="{Binding User.LastLoginAt, StringFormat=yyyy-MM-dd HH:mm}" Width="130" />
                            <DataGridCheckBoxColumn Header="内置" Binding="{Binding User.IsBuiltIn}" Width="45" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <Border Grid.Column="1" Style="{StaticResource Card}" Visibility="{Binding SelectedUser, Converter={StaticResource NotEmptyToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="用户信息" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="账号" />
                            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                            <TextBlock Text="姓名" />
                            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                            <TextBlock Text="卡号（刷卡登录）" />
                            <TextBox Text="{Binding CardNo, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                            <TextBlock Text="新密码（新用户必填；留空不修改）" />
                            <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                            <CheckBox Content="启用" IsChecked="{Binding UserEnabled}" Margin="0,0,0,8" />
                            <TextBlock Text="角色" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding UserRoleItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Text}" IsChecked="{Binding IsChecked}" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="保存用户" Command="{Binding SaveUserCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </TabItem>
        <TabItem Header="角色与权限">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button Content="新增角色" Command="{Binding NewRoleCommand}" Style="{StaticResource ToolButton}" />
                        <Button Content="保存角色" Command="{Binding SaveRoleCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="删除" Command="{Binding DeleteRoleCommand}" Style="{StaticResource DangerButton}" />
                    </WrapPanel>
                    <StackPanel DockPanel.Dock="Bottom" DataContext="{Binding SelectedRole}" Margin="0,6,0,0"
                                Visibility="{Binding Converter={StaticResource NotEmptyToVis}}">
                        <TextBlock Text="编码" />
                        <TextBox Text="{Binding Code}" Margin="0,2,0,4" />
                        <TextBlock Text="名称" />
                        <TextBox Text="{Binding Name}" Margin="0,2,0,4" />
                        <TextBlock Text="等级（数值越大权限越高，只能管理低于自身等级的角色）" TextWrapping="Wrap" />
                        <TextBox Text="{Binding Level}" Margin="0,2,0,4" />
                        <TextBlock Text="说明" />
                        <TextBox Text="{Binding Description}" Margin="0,2,0,4" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" Style="{StaticResource ReadOnlyGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="编码" Binding="{Binding Code}" Width="100" />
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="等级" Binding="{Binding Level}" Width="50" />
                            <DataGridCheckBoxColumn Header="内置" Binding="{Binding IsBuiltIn}" Width="45" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <TextBlock Text="功能权限" Style="{StaticResource CardTitle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="全选（自身拥有）" Command="{Binding CheckAllCommand}" Padding="6,0" Margin="0,0,4,0" />
                                <Button Content="全不选" Command="{Binding UncheckAllCommand}" Padding="6,0" Margin="0,0,4,0" />
                                <Button Content="保存权限" Command="{Binding SaveRolePermissionsCommand}" Style="{StaticResource ButtonPrimary}" />
                            </StackPanel>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding PermissionItems}" BorderThickness="0">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,8,0,2" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Text}" IsChecked="{Binding IsChecked}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="数据权限（可操作设备）" Style="{StaticResource CardTitle}" />
                        <TextBlock DockPanel.Dock="Top" Text="全选或全不选表示不限制" Foreground="Gray" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding DataScopeItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Text}" IsChecked="{Binding IsChecked}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
