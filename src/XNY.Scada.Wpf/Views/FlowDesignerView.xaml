<UserControl x:Class="XNY.Scada.Wpf.Views.FlowDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XNY.Scada.Presentation.ViewModels;assembly=XNY.Scada.Presentation"
             xmlns:local="clr-namespace:XNY.Scada.Wpf"
             Focusable="True" KeyDown="OnKeyDown">
    <UserControl.Resources>
        <!-- 节点属性编辑器：按 Editor 切换控件 -->
        <DataTemplate x:Key="PropertyEditor" DataType="{x:Type vm:NodePropertyItem}">
            <StackPanel Margin="0,0,0,8" ToolTip="{Binding Description}">
                <TextBlock Text="{Binding DisplayName}" Foreground="#4A5568" Margin="0,0,0,2" />
                <ContentControl Content="{Binding}" Focusable="False">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Editor}" Value="Multi">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CodeBox}" Height="110" />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Editor}" Value="Combo">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <ComboBox IsEditable="True" ItemsSource="{Binding Suggestions}" IsTextSearchEnabled="True"
                                                          Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Editor}" Value="Bool">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Value, Converter={StaticResource StringToBool}}" />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Style="{StaticResource Card}" Padding="6">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="流程" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Flows}" SelectedItem="{Binding SelectedFlow}" DisplayMemberPath="Code" Width="150" Margin="0,0,4,0" />
                    <Button Content="打开" Command="{Binding OpenCommand}" Style="{StaticResource ToolButton}" />
                    <TextBlock Text="版本" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" Width="170" Margin="0,0,4,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock><Run Text="v" /><Run Text="{Binding Version, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Status, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Remark, Mode=OneWay}" Foreground="Gray" /></TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="打开版本" Command="{Binding OpenVersionCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="新建" Command="{Binding NewFlowCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="导入" Command="{Binding ImportCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="导出" Command="{Binding ExportCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="删除流程" Command="{Binding DeleteFlowCommand}" Style="{StaticResource DangerButton}" />
                </WrapPanel>
                <WrapPanel Margin="0,6,0,0">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="Bold">
                        <Run Text="{Binding Code, Mode=OneWay}" /><Run Text=" v" /><Run Text="{Binding Version, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="● 未保存" Foreground="#F0A020" VerticalAlignment="Center" Margin="0,0,12,0"
                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                    <Button Content="保存草稿" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="校验" Command="{Binding ValidateCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="发布（签名）" Command="{Binding PublishCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="模拟运行" Command="{Binding SimulateCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="撤销 Ctrl+Z" Command="{Binding UndoCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="删除选中 Del" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="设为起点" Command="{Binding SetStartCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="断点" Command="{Binding ToggleBreakpointCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="自动布局" Command="{Binding AutoLayoutCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="清除高亮" Command="{Binding ClearExecStateCommand}" Style="{StaticResource ToolButton}" />
                    <TextBlock Text="缩放" Style="{StaticResource FieldLabel}" Margin="12,0,6,0" />
                    <Slider x:Name="ZoomSlider" Minimum="0.4" Maximum="1.6" Value="1" Width="120" VerticalAlignment="Center" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- 节点面板：拖拽到画布或双击添加 -->
            <Border Style="{StaticResource Card}" Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Palette}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PaletteGroup}">
                                <Expander Header="{Binding Category}" IsExpanded="True" Margin="0,0,0,4">
                                    <ItemsControl ItemsSource="{Binding Nodes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="2" Padding="6,4" CornerRadius="3" Cursor="Hand" Background="#F7F9FC"
                                                        BorderBrush="{Binding Category, Converter={StaticResource CategoryBrush}}" BorderThickness="3,0,0,0"
                                                        ToolTip="{Binding Description}"
                                                        MouseMove="OnPaletteMouseMove" MouseLeftButtonDown="OnPaletteMouseDown">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 画布 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                <Grid>
                    <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="OnCanvasWheel">
                        <Grid x:Name="CanvasRoot" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" AllowDrop="True"
                              Drop="OnCanvasDrop" MouseLeftButtonDown="OnCanvasMouseDown" MouseMove="OnCanvasMouseMove" MouseLeftButtonUp="OnCanvasMouseUp">
                            <Grid.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding Value, ElementName=ZoomSlider}" ScaleY="{Binding Value, ElementName=ZoomSlider}" />
                            </Grid.LayoutTransform>
                            <Grid.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing Brush="#FAFBFD">
                                            <GeometryDrawing.Pen>
                                                <Pen Brush="#EDF0F5" Thickness="0.6" />
                                            </GeometryDrawing.Pen>
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,20,20" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Grid.Background>

                            <!-- 连线层 -->
                            <ItemsControl ItemsSource="{Binding Edges}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FlowEdgeViewModel}">
                                        <Canvas>
                                            <!-- 透明粗线用于点击命中 -->
                                            <Path Data="{Binding PathData, Converter={StaticResource PathData}}" Stroke="Transparent" StrokeThickness="10"
                                                  Cursor="Hand" MouseLeftButtonDown="OnEdgeMouseDown" />
                                            <Path Data="{Binding PathData, Converter={StaticResource PathData}}" StrokeThickness="2" IsHitTestVisible="False">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Stroke" Value="#7A8699" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Stroke" Value="#326CE5" />
                                                                <Setter Property="StrokeThickness" Value="3" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <Border Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}" Background="#FFFFFFFF" CornerRadius="2" Padding="3,0"
                                                    IsHitTestVisible="False" RenderTransform="1,0,0,1,-12,-8">
                                                <TextBlock Text="{Binding Port}" FontSize="10" Foreground="#4A5568" />
                                            </Border>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 节点层 -->
                            <ItemsControl ItemsSource="{Binding Nodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FlowNodeViewModel}">
                                        <Grid Width="170" Height="64">
                                            <Border x:Name="Body" CornerRadius="5" Background="White" BorderThickness="2" Cursor="SizeAll"
                                                    MouseLeftButtonDown="OnNodeMouseDown" MouseMove="OnNodeMouseMove" MouseLeftButtonUp="OnNodeMouseUp">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="#C9D1DC" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ExecState}" Value="Running">
                                                                <Setter Property="BorderBrush" Value="#326CE5" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ExecState}" Value="Done">
                                                                <Setter Property="BorderBrush" Value="#2EB85C" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ExecState}" Value="Failed">
                                                                <Setter Property="BorderBrush" Value="#E53E3E" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#E53E3E" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#326CE5" />
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect Color="#326CE5" BlurRadius="10" ShadowDepth="0" Opacity="0.6" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Top" Background="{Binding Category, Converter={StaticResource CategoryBrush}}" CornerRadius="3,3,0,0" Padding="6,2">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="●" Foreground="#FF6B6B" ToolTip="断点"
                                                                       Visibility="{Binding HasBreakpoint, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock DockPanel.Dock="Right" Text="▶ " Foreground="#FFE066" ToolTip="起始节点"
                                                                       Visibility="{Binding IsStart, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </Border>
                                                    <StackPanel Margin="6,2">
                                                        <TextBlock FontSize="10" Foreground="Gray"><Run Text="{Binding Id, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding TypeName, Mode=OneWay}" /></TextBlock>
                                                        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#4A5568" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <!-- 输入锚点 -->
                                            <Ellipse Width="10" Height="10" Fill="White" Stroke="#7A8699" StrokeThickness="1.5"
                                                     HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-5,0,0" IsHitTestVisible="False" />
                                            <!-- 输出端口：从端口拖到目标节点完成连线 -->
                                            <ItemsControl ItemsSource="{Binding PortItems}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                        <Setter Property="Canvas.Top" Value="58" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:PortInfo}">
                                                        <Ellipse Width="12" Height="12" Fill="#326CE5" Stroke="White" StrokeThickness="1.5" Cursor="Cross"
                                                                 ToolTip="{Binding Name}" MouseLeftButtonDown="OnPortMouseDown" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 正在连线的临时线 -->
                            <Canvas IsHitTestVisible="False">
                                <Line x:Name="DragLine" Stroke="#326CE5" StrokeThickness="2" StrokeDashArray="4,2" Visibility="Collapsed" />
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                    <TextBlock Text="从左侧拖入节点；拖动节点底部蓝色端口到目标节点建立连线；Ctrl+滚轮缩放" Foreground="Gray"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" IsHitTestVisible="False" />
                    <TextBlock Text="请先打开或新建流程" FontSize="18" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="2" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- 右侧属性 -->
            <TabControl Grid.Column="3" Margin="0,5,5,5">
                <TabItem Header="节点">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8" DataContext="{Binding SelectedNode}"
                                    Visibility="{Binding Converter={StaticResource NotEmptyToVis}}">
                            <TextBlock Style="{StaticResource CardTitle}"><Run Text="{Binding TypeName, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Id, Mode=OneWay}" Foreground="Gray" /></TextBlock>
                            <TextBlock Text="{Binding Descriptor.Description}" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8" />
                            <TextBlock Text="名称" Foreground="#4A5568" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />
                            <TextBlock Text="节点超时 ms（0 不限，设置后出现 timeout 端口）" Foreground="#4A5568" />
                            <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,12" />
                            <ItemsControl ItemsSource="{Binding Properties}" ItemTemplate="{StaticResource PropertyEditor}" />
                            <TextBlock Text="输出端口" Foreground="#4A5568" Margin="0,8,0,2" />
                            <ItemsControl ItemsSource="{Binding Ports}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#EBF2FF" CornerRadius="2" Padding="4,1" Margin="0,0,4,4">
                                            <TextBlock Text="{Binding}" FontSize="11" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="所有节点均可接 error 端口处理异常" Foreground="Gray" FontSize="11" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="流程">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock Text="编码" Foreground="#4A5568" />
                            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                            <TextBlock Text="名称" Foreground="#4A5568" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                            <TextBlock Text="说明" Foreground="#4A5568" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                            <TextBlock Text="工位（变量作用域）" Foreground="#4A5568" />
                            <TextBox Text="{Binding Station, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" />
                            <TextBlock Text="并发策略" Foreground="#4A5568" />
                            <ComboBox ItemsSource="{Binding ConcurrencyModes}" SelectedItem="{Binding Concurrency}" Margin="0,2,0,6" />
                            <TextBlock Text="流程超时 ms" Foreground="#4A5568" />
                            <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10" />
                            <DockPanel>
                                <TextBlock Text="触发器" Style="{StaticResource CardTitle}" />
                                <Button Content="添加" Command="{Binding AddTriggerCommand}" HorizontalAlignment="Right" Padding="8,0" />
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Triggers}" Style="{StaticResource EditGrid}" MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridComboBoxColumn Header="类型" SelectedItemBinding="{Binding Type}" ItemsSource="{x:Static local:EnumLists.TriggerTypes}" Width="110" />
                                    <DataGridTextColumn Header="点位" Binding="{Binding Tag}" Width="110" />
                                    <DataGridTextColumn Header="周期ms" Binding="{Binding IntervalMs}" Width="55" />
                                    <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="70" />
                                    <DataGridTextColumn Header="条件" Binding="{Binding Condition}" Width="90" />
                                    <DataGridTextColumn Header="工位" Binding="{Binding Station}" Width="50" />
                                    <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                                    <DataGridTemplateColumn Width="36">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="删" Padding="4,0"
                                                        Command="{Binding DataContext.RemoveTriggerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock Text="变量" Style="{StaticResource CardTitle}" />
                                <Button Content="添加" Command="{Binding AddVariableCommand}" HorizontalAlignment="Right" Padding="8,0" />
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Variables}" Style="{StaticResource EditGrid}" MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="90" />
                                    <DataGridTextColumn Header="默认值" Binding="{Binding DefaultValue}" Width="70" />
                                    <DataGridComboBoxColumn Header="作用域" SelectedItemBinding="{Binding Scope}" ItemsSource="{x:Static local:EnumLists.VariableScopes}" Width="75" />
                                    <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="*" />
                                    <DataGridTemplateColumn Width="36">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="删" Padding="4,0"
                                                        Command="{Binding DataContext.RemoveVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="连线">
                    <DockPanel Margin="8">
                        <Button DockPanel.Dock="Top" Content="添加连线" Command="{Binding AddEdgeCommand}" HorizontalAlignment="Left" Margin="0,0,0,6" Padding="8,2" />
                        <DataGrid ItemsSource="{Binding Edges}" SelectedItem="{Binding SelectedEdge}" Style="{StaticResource EditGrid}">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn Header="起点" SelectedItemBinding="{Binding FromId}" Width="*">
                                    <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource" Value="{Binding DataContext.NodeIds, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </Style>
                                    </DataGridComboBoxColumn.ElementStyle>
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource" Value="{Binding DataContext.NodeIds, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>
                                <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="70" />
                                <DataGridComboBoxColumn Header="终点" SelectedItemBinding="{Binding ToId}" Width="*">
                                    <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource" Value="{Binding DataContext.NodeIds, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </Style>
                                    </DataGridComboBoxColumn.ElementStyle>
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource" Value="{Binding DataContext.NodeIds, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="校验">
                    <ListBox ItemsSource="{Binding Issues}" Margin="4" MouseDoubleClick="OnIssueDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#B7791F" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Foreground" Value="#E53E3E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                <TabItem Header="模拟">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="输入变量 JSON（如 {&quot;CellCode&quot;:&quot;A001&quot;}）" Foreground="#4A5568" />
                            <TextBox Text="{Binding SimulationInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CodeBox}" Height="70" Margin="0,2,0,6" />
                            <Button Content="模拟运行" Command="{Binding SimulateCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding SimulationResult}" TextWrapping="Wrap" FontWeight="Bold" Margin="0,8" />
                        </StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DataGrid ItemsSource="{Binding SimulationTrace}" Style="{StaticResource ReadOnlyGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="节点" Binding="{Binding NodeName}" Width="*" />
                                    <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="55" />
                                    <DataGridTextColumn Header="ms" Binding="{Binding DurationMs}" Width="40" />
                                    <DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding SimulationVariables}" Style="{StaticResource ReadOnlyGrid}" Margin="0,6,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="变量" Binding="{Binding Key}" Width="*" />
                                    <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="JSON">
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="从画布生成" Command="{Binding RefreshJsonCommand}" Style="{StaticResource ToolButton}" />
                            <Button Content="应用到画布" Command="{Binding ApplyJsonCommand}" Style="{StaticResource PrimaryButton}" />
                        </StackPanel>
                        <TextBox Text="{Binding JsonText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CodeBox}" FontSize="12" />
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
