<UserControl x:Class="XNY.Scada.Wpf.Views.AlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <WrapPanel Style="{StaticResource ToolBarPanel}">
            <Button Content="确认选中" Command="{Binding AcknowledgeCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Content="全部确认" Command="{Binding AcknowledgeAllCommand}" Style="{StaticResource ToolButton}" />
        </WrapPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="活动报警" Style="{StaticResource CardTitle}" />
                <DataGrid ItemsSource="{Binding ActiveAlarms}" SelectedItem="{Binding SelectedAlarm}" Style="{StaticResource ReadOnlyGrid}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="级别" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="{Binding Level, Converter={StaticResource StatusBrush}}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding Level}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="发生时间" Binding="{Binding RaisedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" />
                        <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="200" />
                        <DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="*" />
                        <DataGridTextColumn Header="确认人" Binding="{Binding AcknowledgedBy}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <WrapPanel Grid.Row="2" Style="{StaticResource ToolBarPanel}">
            <TextBlock Text="从" Style="{StaticResource FieldLabel}" />
            <DatePicker SelectedDate="{Binding From}" Width="130" Margin="0,0,8,0" />
            <TextBlock Text="到" Style="{StaticResource FieldLabel}" />
            <DatePicker SelectedDate="{Binding To}" Width="130" Margin="0,0,8,0" />
            <TextBlock Text="关键字" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,8,0" />
            <Button Content="查询历史" Command="{Binding QueryCommand}" Style="{StaticResource PrimaryButton}" />
        </WrapPanel>
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding History}" Style="{StaticResource ReadOnlyGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="70" />
                    <DataGridTextColumn Header="发生" Binding="{Binding RaisedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" />
                    <DataGridTextColumn Header="恢复" Binding="{Binding ClearedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" />
                    <DataGridTextColumn Header="确认" Binding="{Binding AcknowledgedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" />
                    <DataGridTextColumn Header="确认人" Binding="{Binding AcknowledgedBy}" Width="90" />
                    <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="180" />
                    <DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
