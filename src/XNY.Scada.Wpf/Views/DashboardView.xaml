<UserControl x:Class="XNY.Scada.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XNY.Scada.Presentation.ViewModels;assembly=XNY.Scada.Presentation">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="240" />
        </Grid.RowDefinitions>

        <!-- 操作栏 -->
        <Border Style="{StaticResource Card}" Padding="8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Ellipse Width="14" Height="14" Fill="{Binding EngineRunning, Converter={StaticResource StatusBrush}}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding MachineTypeName}" FontSize="16" FontWeight="Bold" Margin="8,0,16,0" VerticalAlignment="Center" />
                    <Button Content="启动生产" Command="{Binding StartProductionCommand}" Style="{StaticResource PrimaryButton}" />
                    <Button Content="停止生产" Command="{Binding StopProductionCommand}" Style="{StaticResource DangerButton}" />
                    <Button Content="计数清零" Command="{Binding ResetCountersCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="确认全部报警" Command="{Binding AcknowledgeAllCommand}" Style="{StaticResource ToolButton}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ManualFlows}" HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}" Style="{StaticResource ToolButton}" ToolTip="手动触发流程"
                                    Command="{Binding DataContext.TriggerFlowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- 指标卡片 -->
        <UniformGrid Grid.Row="1" Rows="1">
            <Border Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="产量" Foreground="Gray" /><TextBlock Text="{Binding Total}" Style="{StaticResource BigNumber}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="OK" Foreground="Gray" /><TextBlock Text="{Binding Ok}" Style="{StaticResource BigNumber}" Foreground="#2EB85C" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="NG" Foreground="Gray" /><TextBlock Text="{Binding Ng}" Style="{StaticResource BigNumber}" Foreground="#E53E3E" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="良率 %" Foreground="Gray" /><TextBlock Text="{Binding Yield}" Style="{StaticResource BigNumber}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel><TextBlock Text="UPH" Foreground="Gray" /><TextBlock Text="{Binding Uph}" Style="{StaticResource BigNumber}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="OEE %" Foreground="Gray" />
                    <TextBlock Text="{Binding Oee}" Style="{StaticResource BigNumber}" />
                    <TextBlock Foreground="Gray" FontSize="11">
                        <Run Text="A" /><Run Text="{Binding Availability, Mode=OneWay}" /><Run Text=" P" /><Run Text="{Binding Performance, Mode=OneWay}" /><Run Text=" Q" /><Run Text="{Binding Quality, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 中部：设备 + 机型可视化 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="设备状态" Style="{StaticResource CardTitle}" />
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceStatusItem}">
                                <Grid Margin="0,2" ToolTip="{Binding LastError}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="{Binding Connected, Converter={StaticResource StatusBrush}}" />
                                    <TextBlock Grid.Column="1" Margin="6,0"><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" " Foreground="Gray" /><Run Text="{Binding DriverKey, Mode=OneWay}" Foreground="Gray" /></TextBlock>
                                    <TextBlock Grid.Column="2" Foreground="Gray"><Run Text="{Binding LastScanMs, Mode=OneWay}" /><Run Text="ms" /></TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock DockPanel.Dock="Top" Text="关键点位" Style="{StaticResource CardTitle}" Margin="0,12,0,6" />
                    <DataGrid ItemsSource="{Binding KeyTags}" Style="{StaticResource ReadOnlyGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="点位" Binding="{Binding FullName}" Width="*" />
                            <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- 托盘矩阵（组盘/拆盘） -->
                <Border Style="{StaticResource Card}" Visibility="{Binding ShowTray, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}">
                            <Run Text="当前托盘 " /><Run Text="{Binding CurrentTrayCode, Mode=OneWay}" /><Run Text="   已装 " /><Run Text="{Binding TrayCellCount, Mode=OneWay}" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding TrayCells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding DataContext.TrayCols, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TrayCellItem}">
                                    <Border Margin="2" CornerRadius="3" BorderBrush="#C9D1DC" BorderThickness="1" ToolTip="{Binding CellCode}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F7F9FC" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasCell}" Value="True">
                                                        <Setter Property="Background" Value="#9AE6B4" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Viewbox Margin="2">
                                            <TextBlock Text="{Binding Position}" Foreground="#4A5568" />
                                        </Viewbox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
                <!-- 档位料箱（分档） -->
                <Border Style="{StaticResource Card}" Visibility="{Binding ShowBins, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="档位料箱" Style="{StaticResource CardTitle}" />
                        <ItemsControl ItemsSource="{Binding Bins}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BinItem}">
                                    <Border Width="150" Margin="4" Padding="8" CornerRadius="4" BorderThickness="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#DDE2EA" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFull}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#E53E3E" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock FontSize="22" FontWeight="Bold"><Run Text="{Binding Count, Mode=OneWay}" /><Run Text=" / " Foreground="Gray" FontSize="14" /><Run Text="{Binding Capacity, Mode=OneWay}" Foreground="Gray" FontSize="14" /></TextBlock>
                                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,4" />
                                            <Button Content="换箱清零" HorizontalAlignment="Right" Padding="6,2" FontSize="11"
                                                    Command="{Binding DataContext.ResetBinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="NG 统计" Style="{StaticResource CardTitle}" />
                    <DataGrid ItemsSource="{Binding NgCounts}" Style="{StaticResource ReadOnlyGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NG 代码" Binding="{Binding Code}" Width="*" />
                            <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 底部：实时记录 + 报警 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="实时生产记录" Style="{StaticResource CardTitle}" />
                    <DataGrid ItemsSource="{Binding RecentRecords}" Style="{StaticResource ReadOnlyGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding CreateTime, StringFormat=HH:mm:ss}" Width="80" />
                            <DataGridTextColumn Header="电芯码" Binding="{Binding CellCode}" Width="*" />
                            <DataGridTextColumn Header="托盘" Binding="{Binding TrayCode}" Width="110" />
                            <DataGridTextColumn Header="电压" Binding="{Binding Voltage}" Width="70" />
                            <DataGridTextColumn Header="内阻" Binding="{Binding InternalResistance}" Width="70" />
                            <DataGridTextColumn Header="档位" Binding="{Binding BinName}" Width="80" />
                            <DataGridCheckBoxColumn Header="OK" Binding="{Binding IsOk}" Width="45" />
                            <DataGridTextColumn Header="NG" Binding="{Binding NgCode}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="当前报警" Style="{StaticResource CardTitle}" />
                    <ListBox ItemsSource="{Binding ActiveAlarms}" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Level, Converter={StaticResource StatusBrush}}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding RaisedAt, StringFormat=HH:mm:ss}" Foreground="Gray" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Message}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
