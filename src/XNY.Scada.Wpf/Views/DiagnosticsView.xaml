<UserControl x:Class="XNY.Scada.Wpf.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock Text="设备通讯状态" Style="{StaticResource CardTitle}" />
                    <Button Content="重新加载通讯" Command="{Binding ReloadCommand}" Style="{StaticResource ToolButton}" HorizontalAlignment="Right" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding Devices}" Style="{StaticResource ReadOnlyGrid}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="状态" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Fill="{Binding Connected, Converter={StaticResource StatusBrush}}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding StatusText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="设备" Binding="{Binding Name}" Width="120" />
                        <DataGridTextColumn Header="驱动" Binding="{Binding DriverKey}" Width="120" />
                        <DataGridTextColumn Header="读取次数" Binding="{Binding ReadCount}" Width="90" />
                        <DataGridTextColumn Header="错误次数" Binding="{Binding ErrorCount}" Width="80" />
                        <DataGridTextColumn Header="扫描耗时ms" Binding="{Binding LastScanMs}" Width="90" />
                        <DataGridTextColumn Header="上次连接" Binding="{Binding LastConnectedAt, StringFormat=MM-dd HH:mm:ss}" Width="110" />
                        <DataGridTextColumn Header="最近错误" Binding="{Binding LastError}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="点位实时值" Style="{StaticResource CardTitle}" Margin="0,0,12,0" />
                    <TextBlock Text="过滤" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,20,0" />
                    <TextBlock Text="选中点位" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding SelectedTag.FullName}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="直读" Command="{Binding ReadCommand}" Style="{StaticResource ToolButton}" />
                    <TextBlock Text="写入值" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding WriteValue, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,6,0" />
                    <Button Content="手动写入（签名）" Command="{Binding WriteCommand}" Style="{StaticResource DangerButton}" />
                </WrapPanel>
                <DataGrid ItemsSource="{Binding FilteredTags}" SelectedItem="{Binding SelectedTag}" Style="{StaticResource ReadOnlyGrid}"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="点位" Binding="{Binding FullName}" Width="200" />
                        <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="100" />
                        <DataGridTextColumn Header="类型" Binding="{Binding DataType}" Width="70" />
                        <DataGridTextColumn Header="读写" Binding="{Binding Access}" Width="80" />
                        <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" />
                        <DataGridTextColumn Header="质量" Binding="{Binding Quality}" Width="70" />
                        <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
