<UserControl x:Class="XNY.Scada.Wpf.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="140" />
        </Grid.RowDefinitions>
        <WrapPanel Style="{StaticResource ToolBarPanel}">
            <TextBlock Text="从" Style="{StaticResource FieldLabel}" />
            <DatePicker SelectedDate="{Binding From}" Width="130" Margin="0,0,8,0" />
            <TextBlock Text="到" Style="{StaticResource FieldLabel}" />
            <DatePicker SelectedDate="{Binding To}" Width="130" Margin="0,0,8,0" />
            <TextBlock Text="用户" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,8,0" />
            <TextBlock Text="动作" Style="{StaticResource FieldLabel}" />
            <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}" Width="140" Margin="0,0,8,0" />
            <TextBlock Text="关键字" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,8,0" />
            <Button Content="查询" Command="{Binding QueryCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Content="导出 CSV" Command="{Binding ExportCommand}" Style="{StaticResource ToolButton}" />
        </WrapPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding Logs}" SelectedItem="{Binding Selected}" Style="{StaticResource ReadOnlyGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" />
                    <DataGridTextColumn Header="用户" Binding="{Binding UserName}" Width="90" />
                    <DataGridTextColumn Header="动作" Binding="{Binding Action}" Width="120" />
                    <DataGridTextColumn Header="对象" Binding="{Binding Target}" Width="220" />
                    <DataGridTextColumn Header="签名人" Binding="{Binding Signer}" Width="80" />
                    <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="120" />
                    <DataGridTextColumn Header="新值" Binding="{Binding NewValue}" Width="*" />
                    <DataGridTextColumn Header="机器" Binding="{Binding Machine}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Grid Grid.Row="2" Margin="5,0,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,4,0">
                <TextBlock DockPanel.Dock="Top" Text="原值" />
                <TextBox Text="{Binding Selected.OldValue, Mode=OneWay}" Style="{StaticResource CodeBox}" IsReadOnly="True" />
            </DockPanel>
            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Text="新值" />
                <TextBox Text="{Binding Selected.NewValue, Mode=OneWay}" Style="{StaticResource CodeBox}" IsReadOnly="True" />
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
