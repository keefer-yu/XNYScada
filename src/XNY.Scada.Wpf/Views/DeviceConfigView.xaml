<UserControl x:Class="XNY.Scada.Wpf.Views.DeviceConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XNY.Scada.Presentation.ViewModels;assembly=XNY.Scada.Presentation"
             xmlns:local="clr-namespace:XNY.Scada.Wpf">
    <UserControl.Resources>
        <DataTemplate x:Key="OptionEditor" DataType="{x:Type vm:DriverOptionItem}">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource FieldLabel}" />
                <ContentControl Grid.Column="1" Content="{Binding}" Focusable="False">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnum}" Value="True">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBool}" Value="True">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Value, Converter={StaticResource StringToBool}}" />
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="设备列表" Style="{StaticResource CardTitle}" />
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button Content="新增" Command="{Binding NewDeviceCommand}" Style="{StaticResource ToolButton}" />
                    <Button Content="删除" Command="{Binding DeleteDeviceCommand}" Style="{StaticResource DangerButton}" />
                </WrapPanel>
                <Border DockPanel.Dock="Bottom" Background="#FFF7E6" Padding="8" CornerRadius="3" Margin="0,6,0,0"
                        Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="配置已修改，需应用后通讯才生效" TextWrapping="Wrap" />
                        <Button Content="应用配置（重启通讯）" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DriverKey}" Foreground="Gray" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="设备参数" Style="{StaticResource CardTitle}" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="设备名称" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="1" Text="驱动 / PLC 类型" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Drivers}" SelectedValuePath="Key" SelectedValue="{Binding DriverKey}" Margin="0,0,0,6">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock><Run Text="{Binding Vendor, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DisplayName, Mode=OneWay}" /></TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Row="2" Text="启用" Style="{StaticResource FieldLabel}" />
                        <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding DeviceEnabled}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="3" Text="说明" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DeviceDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                    </Grid>
                    <TextBlock Text="通讯参数" Style="{StaticResource CardTitle}" Margin="0,8,0,8" />
                    <ItemsControl ItemsSource="{Binding DriverOptions}" ItemTemplate="{StaticResource OptionEditor}" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="保存设备" Command="{Binding SaveDeviceCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="测试连接" Command="{Binding TestConnectionCommand}" Style="{StaticResource ToolButton}" />
                    </WrapPanel>
                    <TextBlock Text="地址格式说明" Style="{StaticResource CardTitle}" Margin="0,16,0,4" />
                    <TextBlock Text="{Binding AddressHelp}" TextWrapping="Wrap" Foreground="#4A5568" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TabControl Grid.Column="2" Margin="5">
            <TabItem Header="点位">
                <DockPanel Margin="4">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button Content="添加点位" Command="{Binding AddTagCommand}" Style="{StaticResource ToolButton}" />
                        <Button Content="删除点位" Command="{Binding RemoveTagCommand}" Style="{StaticResource ToolButton}" />
                        <Button Content="保存点位" Command="{Binding SaveTagsCommand}" Style="{StaticResource PrimaryButton}" />
                        <Button Content="导入 CSV" Command="{Binding ImportCsvCommand}" Style="{StaticResource ToolButton}" />
                        <Button Content="导出 CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource ToolButton}" />
                    </WrapPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="扫描组" Style="{StaticResource FieldLabel}" />
                        <Button DockPanel.Dock="Right" Content="保存扫描组" Command="{Binding SaveGroupsCommand}" Style="{StaticResource ToolButton}" />
                        <Button DockPanel.Dock="Right" Content="新增扫描组" Command="{Binding AddGroupCommand}" Style="{StaticResource ToolButton}" />
                        <DataGrid ItemsSource="{Binding Groups}" Style="{StaticResource EditGrid}" MaxHeight="120">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="50" />
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="扫描周期 ms" Binding="{Binding ScanIntervalMs}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}" Style="{StaticResource EditGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="130" />
                            <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="110" />
                            <DataGridComboBoxColumn Header="类型" SelectedItemBinding="{Binding DataType}" ItemsSource="{x:Static local:EnumLists.TagDataTypes}" Width="80" />
                            <DataGridTextColumn Header="长度" Binding="{Binding Length}" Width="50" />
                            <DataGridTextColumn Header="系数" Binding="{Binding Scale}" Width="55" />
                            <DataGridTextColumn Header="偏移" Binding="{Binding Offset}" Width="55" />
                            <DataGridComboBoxColumn Header="读写" SelectedItemBinding="{Binding Access}" ItemsSource="{x:Static local:EnumLists.TagAccessModes}" Width="85" />
                            <DataGridComboBoxColumn Header="扫描组" SelectedValueBinding="{Binding GroupId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="100">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding DataContext.Groups, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding DataContext.Groups, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="报警定义">
                <DockPanel Margin="4">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button Content="添加" Command="{Binding AddAlarmCommand}" Style="{StaticResource ToolButton}" />
                        <Button Content="删除" Command="{Binding RemoveAlarmCommand}" Style="{StaticResource ToolButton}" />
                        <Button Content="保存报警定义" Command="{Binding SaveAlarmsCommand}" Style="{StaticResource PrimaryButton}" />
                        <TextBlock Text="点位填写全名：设备名.点位名；Bit 类型在值为 true 时报警" VerticalAlignment="Center" Foreground="Gray" Margin="8,0" />
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding AlarmDefinitions}" SelectedItem="{Binding SelectedAlarm}" Style="{StaticResource EditGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="点位" Binding="{Binding TagName}" Width="180" />
                            <DataGridComboBoxColumn Header="类型" SelectedItemBinding="{Binding Kind}" ItemsSource="{x:Static local:EnumLists.AlarmKinds}" Width="80" />
                            <DataGridTextColumn Header="阈值" Binding="{Binding Threshold}" Width="70" />
                            <DataGridComboBoxColumn Header="级别" SelectedItemBinding="{Binding Level}" ItemsSource="{x:Static local:EnumLists.AlarmLevels}" Width="90" />
                            <DataGridTextColumn Header="报警内容" Binding="{Binding Message}" Width="*" />
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="50" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
