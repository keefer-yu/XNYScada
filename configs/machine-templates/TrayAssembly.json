{
  "MachineType": "TrayAssembly",
  "Name": "组盘机（标准模板）",
  "Description": "托盘进站校验 → 电芯扫码/重码/规格/MES 校验 → 绑定托盘位置 → 满盘完成上传。PLC 采用 请求位/完成位/结果字 握手。",
  "Params": {
    "MachineName": "组盘机-01",
    "LineCode": "L01",
    "StationCode": "ST01"
  },
  "Layout": {
    "ShowTray": true,
    "TrayRows": 4,
    "TrayCols": 6,
    "ShowBins": false,
    "ShowNg": true,
    "NgBoxCount": 1,
    "KeyTags": [ "PLC1.Auto", "PLC1.TrayCode", "PLC1.CellCode", "PLC1.Position", "PLC1.Voltage", "PLC1.IR", "PLC1.CellCount" ],
    "ManualFlows": [ "TA_ForceComplete" ]
  },
  "Devices": [
    {
      "Name": "PLC1",
      "DriverKey": "Simulator",
      "Description": "主控 PLC（现场改为 SiemensS7 / MitsubishiMc / OmronFins / InovanceTcp 驱动即可）",
      "Options": { "Instance": "TrayAssembly" },
      "Groups": [
        {
          "Name": "Handshake",
          "ScanIntervalMs": 50,
          "Tags": [
            { "Name": "TrayReq", "Address": "M10", "DataType": "Bool", "Access": "Read", "Description": "托盘到位请求（PLC→上位）" },
            { "Name": "TrayDone", "Address": "M11", "DataType": "Bool", "Description": "托盘处理完成（上位→PLC）" },
            { "Name": "TrayResult", "Address": "D30", "DataType": "Int16", "Description": "托盘结果 1=OK 2=NG" },
            { "Name": "TrayCode", "Address": "D300", "DataType": "String", "Length": 32, "Access": "Read", "Description": "托盘码" },
            { "Name": "TrayFull", "Address": "M12", "DataType": "Bool", "Description": "满盘信号（上位→PLC）" },
            { "Name": "CellCount", "Address": "D32", "DataType": "Int16", "Description": "托盘已绑电芯数" },
            { "Name": "CellReq", "Address": "M0", "DataType": "Bool", "Access": "Read", "Description": "电芯到位请求（PLC→上位）" },
            { "Name": "CellDone", "Address": "M1", "DataType": "Bool", "Description": "电芯处理完成（上位→PLC）" },
            { "Name": "CellResult", "Address": "D10", "DataType": "Int16", "Description": "电芯结果 1=放入托盘 2=NG 剔除" },
            { "Name": "CellCode", "Address": "D100", "DataType": "String", "Length": 32, "Access": "Read", "Description": "电芯条码" },
            { "Name": "Position", "Address": "D12", "DataType": "Int16", "Access": "Read", "Description": "托盘位置（1 起）" },
            { "Name": "Voltage", "Address": "D14", "DataType": "Float", "Access": "Read", "Description": "电压 V" },
            { "Name": "IR", "Address": "D16", "DataType": "Float", "Access": "Read", "Description": "内阻 mΩ" }
          ]
        },
        {
          "Name": "Status",
          "ScanIntervalMs": 200,
          "Tags": [
            { "Name": "Auto", "Address": "M100", "DataType": "Bool", "Access": "Read", "Description": "自动运行" },
            { "Name": "EStop", "Address": "M101", "DataType": "Bool", "Access": "Read", "Description": "急停" },
            { "Name": "AirLow", "Address": "M102", "DataType": "Bool", "Access": "Read", "Description": "气压低" },
            { "Name": "DoorOpen", "Address": "M103", "DataType": "Bool", "Access": "Read", "Description": "安全门打开" },
            { "Name": "Output", "Address": "D500", "DataType": "Int32", "Access": "Read", "Description": "PLC 产量计数" }
          ]
        }
      ]
    }
  ],
  "Alarms": [
    { "TagName": "PLC1.EStop", "Kind": "Bit", "Level": "Critical", "Message": "急停按下" },
    { "TagName": "PLC1.AirLow", "Kind": "Bit", "Level": "Error", "Message": "气源压力不足" },
    { "TagName": "PLC1.DoorOpen", "Kind": "Bit", "Level": "Warning", "Message": "安全门打开" }
  ],
  "Recipes": [
    {
      "Code": "TA-280AH",
      "Name": "280Ah 组盘 4x6",
      "ProductModel": "LFP-280Ah",
      "Activate": true,
      "Params": {
        "TrayRows": 4,
        "TrayCols": 6,
        "VoltageMin": 3.0,
        "VoltageMax": 3.6,
        "IrMax": 0.5
      }
    }
  ],
  "MesInterfaces": [
    {
      "Code": "TrayCheck",
      "Name": "托盘校验",
      "Url": "http://mes.local/api/tray/check",
      "Method": "POST",
      "RequestTemplate": "{\"trayCode\":\"${TrayCode}\",\"station\":\"${Station}\"}",
      "ResponseMapJson": "{\"Code\":\"code\",\"Msg\":\"message\"}",
      "SuccessExpression": "Code == 0",
      "TimeoutMs": 3000,
      "RetryCount": 1,
      "Enabled": false
    },
    {
      "Code": "CellCheck",
      "Name": "电芯进站校验",
      "Url": "http://mes.local/api/cell/check",
      "Method": "POST",
      "RequestTemplate": "{\"cellCode\":\"${CellCode}\",\"trayCode\":\"${TrayCode}\"}",
      "ResponseMapJson": "{\"Code\":\"code\",\"Msg\":\"message\"}",
      "SuccessExpression": "Code == 0",
      "TimeoutMs": 3000,
      "RetryCount": 1,
      "Enabled": false
    },
    {
      "Code": "TrayUpload",
      "Name": "组盘结果上传",
      "Url": "http://mes.local/api/tray/bind",
      "Method": "POST",
      "RequestTemplate": "{\"trayCode\":\"${TrayCode}\",\"cellCount\":${CellCount}}",
      "ResponseMapJson": "{\"Code\":\"code\",\"Msg\":\"message\"}",
      "SuccessExpression": "Code == 0",
      "TimeoutMs": 5000,
      "RetryCount": 2,
      "CacheWhenOffline": true,
      "Enabled": false
    }
  ],
  "Flows": [
    {
      "Code": "TA_TrayIn",
      "Name": "托盘进站",
      "Description": "读取托盘码并校验，登记为当前在制托盘（工位变量 TrayCode）",
      "Station": "ST01",
      "TimeoutMs": 30000,
      "StartNodeId": "read",
      "Triggers": [ { "Type": "TagRisingEdge", "Tag": "PLC1.TrayReq" } ],
      "Nodes": [
        { "Id": "read", "Type": "ReadTag", "Name": "读托盘码", "X": 40, "Y": 40, "Properties": { "Tag": "PLC1.TrayCode", "Variable": "TrayCode" } },
        { "Id": "check", "Type": "BarcodeCheck", "Name": "托盘码校验", "X": 40, "Y": 140, "Properties": { "Value": "TrayCode", "Regex": "^T[A-Z0-9]{4,30}$", "MinLength": "5" } },
        { "Id": "mes", "Type": "MesCall", "Name": "MES 托盘校验", "X": 40, "Y": 240, "Properties": { "InterfaceCode": "TrayCheck", "Args": "TrayCode = TrayCode\nStation = {Sys:Station}" } },
        { "Id": "register", "Type": "SetVariable", "Name": "登记在制托盘", "X": 40, "Y": 340, "Properties": { "Assignments": "TrayCode = TrayCode", "Scope": "Station" } },
        { "Id": "reset", "Type": "WriteTags", "Name": "复位满盘/计数", "X": 40, "Y": 440, "Properties": { "Mappings": "PLC1.TrayFull = false\nPLC1.CellCount = 0" } },
        { "Id": "hsOk", "Type": "Handshake", "Name": "回复 OK", "X": 40, "Y": 540, "Properties": { "RequestTag": "PLC1.TrayReq", "DoneTag": "PLC1.TrayDone", "ResultTag": "PLC1.TrayResult", "Result": "1", "Timeout": "5000" } },
        { "Id": "alarm", "Type": "RaiseAlarm", "Name": "托盘 NG 报警", "X": 300, "Y": 240, "Properties": { "Source": "TrayCheck", "Message": "托盘 ${TrayCode} 校验失败：${NgReason}", "Level": "Warning" } },
        { "Id": "hsNg", "Type": "Handshake", "Name": "回复 NG", "X": 300, "Y": 340, "Properties": { "RequestTag": "PLC1.TrayReq", "DoneTag": "PLC1.TrayDone", "ResultTag": "PLC1.TrayResult", "Result": "2", "Timeout": "5000" } },
        { "Id": "timeout", "Type": "RaiseAlarm", "Name": "握手超时", "X": 300, "Y": 540, "Properties": { "Source": "TrayHandshake", "Message": "托盘握手超时：PLC 未复位请求位", "Level": "Error" } },
        { "Id": "end", "Type": "End", "Name": "结束", "X": 40, "Y": 640 },
        { "Id": "fail", "Type": "End", "Name": "失败", "X": 300, "Y": 640, "Properties": { "Status": "Failed", "Message": "握手超时" } }
      ],
      "Edges": [
        { "From": "read", "To": "check" },
        { "From": "check", "Port": "ok", "To": "mes" },
        { "From": "check", "Port": "ng", "To": "alarm" },
        { "From": "mes", "Port": "ok", "To": "register" },
        { "From": "mes", "Port": "offline", "To": "register" },
        { "From": "mes", "Port": "ng", "To": "alarm" },
        { "From": "register", "To": "reset" },
        { "From": "reset", "To": "hsOk" },
        { "From": "hsOk", "To": "end" },
        { "From": "hsOk", "Port": "timeout", "To": "timeout" },
        { "From": "alarm", "To": "hsNg" },
        { "From": "hsNg", "To": "end" },
        { "From": "hsNg", "Port": "timeout", "To": "timeout" },
        { "From": "timeout", "To": "fail" }
      ]
    },
    {
      "Code": "TA_Cell",
      "Name": "电芯组盘",
      "Description": "电芯到位：条码/重码/已绑盘/规格/MES 校验通过后绑定到当前托盘位置，满盘自动完成并上传",
      "Station": "ST01",
      "Concurrency": "Queue",
      "TimeoutMs": 30000,
      "StartNodeId": "read",
      "Triggers": [ { "Type": "TagRisingEdge", "Tag": "PLC1.CellReq" } ],
      "Nodes": [
        { "Id": "read", "Type": "ReadTags", "Name": "读电芯数据", "X": 40, "Y": 40, "Properties": { "Mappings": "CellCode = PLC1.CellCode\nPosition = PLC1.Position\nVoltage = PLC1.Voltage\nIR = PLC1.IR" } },
        { "Id": "tray", "Type": "SetVariable", "Name": "取在制托盘", "X": 40, "Y": 130, "Properties": { "Assignments": "TrayCode = {Station:TrayCode}" } },
        { "Id": "hasTray", "Type": "Condition", "Name": "托盘已进站?", "X": 40, "Y": 220, "Properties": { "Expression": "!isEmpty(TrayCode)" } },
        { "Id": "check", "Type": "BarcodeCheck", "Name": "条码/重码/绑盘校验", "X": 40, "Y": 310, "Properties": { "Value": "CellCode", "Regex": "^[A-Z0-9]{10,32}$", "MinLength": "10", "CheckDuplicate": "true", "CheckBound": "true" } },
        { "Id": "spec", "Type": "Condition", "Name": "电压/内阻规格", "X": 40, "Y": 400, "Properties": { "Expression": "Voltage >= {Recipe:VoltageMin} && Voltage <= {Recipe:VoltageMax} && IR <= {Recipe:IrMax}" } },
        { "Id": "mes", "Type": "MesCall", "Name": "MES 电芯校验", "X": 40, "Y": 490, "Properties": { "InterfaceCode": "CellCheck", "Args": "CellCode = CellCode\nTrayCode = TrayCode" } },
        { "Id": "bind", "Type": "BindTray", "Name": "绑定托盘", "X": 40, "Y": 580, "Properties": { "TrayCode": "TrayCode", "Position": "Position", "CellCode": "CellCode", "Rows": "{Recipe:TrayRows}", "Cols": "{Recipe:TrayCols}" } },
        { "Id": "save", "Type": "SaveCellRecord", "Name": "保存记录", "X": 40, "Y": 670, "Properties": { "Fields": "CellCode = CellCode\nTrayCode = TrayCode\nPosition = Position\nVoltage = Voltage\nInternalResistance = IR\nIsOk = true" } },
        { "Id": "count", "Type": "WriteTags", "Name": "写计数/满盘", "X": 40, "Y": 760, "Properties": { "Mappings": "PLC1.CellCount = TrayCellCount\nPLC1.TrayFull = TrayFull" } },
        { "Id": "hsOk", "Type": "Handshake", "Name": "回复放入", "X": 40, "Y": 850, "Properties": { "RequestTag": "PLC1.CellReq", "DoneTag": "PLC1.CellDone", "ResultTag": "PLC1.CellResult", "Result": "1", "Timeout": "5000" } },
        { "Id": "full", "Type": "Condition", "Name": "满盘?", "X": 40, "Y": 940, "Properties": { "Expression": "TrayFull" } },
        { "Id": "complete", "Type": "CompleteTray", "Name": "托盘完成", "X": 40, "Y": 1030, "Properties": { "TrayCode": "TrayCode" } },
        { "Id": "upload", "Type": "MesCall", "Name": "上传组盘结果", "X": 40, "Y": 1120, "Properties": { "InterfaceCode": "TrayUpload", "Args": "TrayCode = TrayCode\nCellCount = TrayCellCount" } },
        { "Id": "release", "Type": "SetVariable", "Name": "释放在制托盘", "X": 40, "Y": 1210, "Properties": { "Assignments": "TrayCode = ''", "Scope": "Station" } },
        { "Id": "end", "Type": "End", "Name": "结束", "X": 40, "Y": 1300 },

        { "Id": "noTray", "Type": "SetVariable", "Name": "NG:无托盘", "X": 320, "Y": 220, "Properties": { "Assignments": "NgCode = 'NO_TRAY'\nNgReason = '托盘未进站'" } },
        { "Id": "ngBarcode", "Type": "SetVariable", "Name": "NG:条码", "X": 320, "Y": 310, "Properties": { "Assignments": "NgCode = 'NG_BARCODE'" } },
        { "Id": "ngSpec", "Type": "SetVariable", "Name": "NG:规格", "X": 320, "Y": 400, "Properties": { "Assignments": "NgCode = 'NG_SPEC'\nNgReason = concat('规格超限 V=', Voltage, ' IR=', IR)" } },
        { "Id": "ngMes", "Type": "SetVariable", "Name": "NG:MES", "X": 320, "Y": 490, "Properties": { "Assignments": "NgCode = 'NG_MES'" } },
        { "Id": "ngBind", "Type": "SetVariable", "Name": "NG:绑定", "X": 320, "Y": 580, "Properties": { "Assignments": "NgCode = 'NG_BIND'" } },
        { "Id": "ngSave", "Type": "SaveNgRecord", "Name": "保存 NG", "X": 600, "Y": 400, "Properties": { "CellCode": "CellCode", "NgCode": "NgCode", "NgReason": "${NgReason}", "BoxNo": "1" } },
        { "Id": "ngRecord", "Type": "SaveCellRecord", "Name": "保存 NG 记录", "X": 600, "Y": 490, "Properties": { "Fields": "CellCode = CellCode\nTrayCode = TrayCode\nPosition = Position\nVoltage = Voltage\nInternalResistance = IR\nIsOk = false\nNgCode = NgCode" } },
        { "Id": "hsNg", "Type": "Handshake", "Name": "回复剔除", "X": 600, "Y": 580, "Properties": { "RequestTag": "PLC1.CellReq", "DoneTag": "PLC1.CellDone", "ResultTag": "PLC1.CellResult", "Result": "2", "Timeout": "5000" } },
        { "Id": "timeout", "Type": "RaiseAlarm", "Name": "握手超时", "X": 600, "Y": 850, "Properties": { "Source": "CellHandshake", "Message": "电芯握手超时：PLC 未复位请求位", "Level": "Error" } },
        { "Id": "fail", "Type": "End", "Name": "失败", "X": 600, "Y": 940, "Properties": { "Status": "Failed", "Message": "握手超时" } }
      ],
      "Edges": [
        { "From": "read", "To": "tray" },
        { "From": "tray", "To": "hasTray" },
        { "From": "hasTray", "Port": "true", "To": "check" },
        { "From": "hasTray", "Port": "false", "To": "noTray" },
        { "From": "check", "Port": "ok", "To": "spec" },
        { "From": "check", "Port": "ng", "To": "ngBarcode" },
        { "From": "spec", "Port": "true", "To": "mes" },
        { "From": "spec", "Port": "false", "To": "ngSpec" },
        { "From": "mes", "Port": "ok", "To": "bind" },
        { "From": "mes", "Port": "offline", "To": "bind" },
        { "From": "mes", "Port": "ng", "To": "ngMes" },
        { "From": "bind", "Port": "ok", "To": "save" },
        { "From": "bind", "Port": "ng", "To": "ngBind" },
        { "From": "save", "To": "count" },
        { "From": "count", "To": "hsOk" },
        { "From": "hsOk", "To": "full" },
        { "From": "hsOk", "Port": "timeout", "To": "timeout" },
        { "From": "full", "Port": "true", "To": "complete" },
        { "From": "full", "Port": "false", "To": "end" },
        { "From": "complete", "To": "upload" },
        { "From": "upload", "Port": "ok", "To": "release" },
        { "From": "upload", "Port": "ng", "To": "release" },
        { "From": "upload", "Port": "offline", "To": "release" },
        { "From": "release", "To": "end" },
        { "From": "noTray", "To": "ngSave" },
        { "From": "ngBarcode", "To": "ngSave" },
        { "From": "ngSpec", "To": "ngSave" },
        { "From": "ngMes", "To": "ngSave" },
        { "From": "ngBind", "To": "ngSave" },
        { "From": "ngSave", "To": "ngRecord" },
        { "From": "ngRecord", "To": "hsNg" },
        { "From": "hsNg", "To": "end" },
        { "From": "hsNg", "Port": "timeout", "To": "timeout" },
        { "From": "timeout", "To": "fail" }
      ]
    },
    {
      "Code": "TA_ForceComplete",
      "Name": "强制满盘",
      "Description": "人工将当前在制托盘标记完成（尾盘）",
      "Station": "ST01",
      "StartNodeId": "tray",
      "Triggers": [ { "Type": "Manual" } ],
      "Nodes": [
        { "Id": "tray", "Type": "SetVariable", "Name": "取在制托盘", "X": 40, "Y": 40, "Properties": { "Assignments": "TrayCode = {Station:TrayCode}" } },
        { "Id": "has", "Type": "Condition", "Name": "有在制托盘?", "X": 40, "Y": 130, "Properties": { "Expression": "!isEmpty(TrayCode)" } },
        { "Id": "confirm", "Type": "Confirm", "Name": "确认", "X": 40, "Y": 220, "Properties": { "Title": "强制满盘", "Message": "确认将托盘 ${TrayCode} 强制满盘下线？", "TimeoutMs": "60000", "Default": "false" } },
        { "Id": "load", "Type": "LoadTray", "Name": "查询电芯数", "X": 40, "Y": 310, "Properties": { "TrayCode": "TrayCode" } },
        { "Id": "complete", "Type": "CompleteTray", "Name": "托盘完成", "X": 40, "Y": 400, "Properties": { "TrayCode": "TrayCode" } },
        { "Id": "signal", "Type": "WriteTag", "Name": "通知 PLC 满盘", "X": 40, "Y": 490, "Properties": { "Tag": "PLC1.TrayFull", "Value": "true" } },
        { "Id": "upload", "Type": "MesCall", "Name": "上传组盘结果", "X": 40, "Y": 580, "Properties": { "InterfaceCode": "TrayUpload", "Args": "TrayCode = TrayCode\nCellCount = TrayCellCount" } },
        { "Id": "release", "Type": "SetVariable", "Name": "释放在制托盘", "X": 40, "Y": 670, "Properties": { "Assignments": "TrayCode = ''", "Scope": "Station" } },
        { "Id": "log", "Type": "Log", "Name": "记录", "X": 40, "Y": 760, "Properties": { "Message": "托盘 ${TrayCode} 已强制满盘，电芯数 ${TrayCellCount}" } },
        { "Id": "none", "Type": "Log", "Name": "无托盘", "X": 300, "Y": 130, "Properties": { "Message": "当前无在制托盘", "Level": "Warning" } },
        { "Id": "end", "Type": "End", "Name": "结束", "X": 300, "Y": 760 }
      ],
      "Edges": [
        { "From": "tray", "To": "has" },
        { "From": "has", "Port": "true", "To": "confirm" },
        { "From": "has", "Port": "false", "To": "none" },
        { "From": "confirm", "Port": "yes", "To": "load" },
        { "From": "confirm", "Port": "no", "To": "end" },
        { "From": "load", "Port": "ok", "To": "complete" },
        { "From": "load", "Port": "ng", "To": "complete" },
        { "From": "complete", "To": "signal" },
        { "From": "signal", "To": "upload" },
        { "From": "upload", "Port": "ok", "To": "release" },
        { "From": "upload", "Port": "ng", "To": "release" },
        { "From": "upload", "Port": "offline", "To": "release" },
        { "From": "release", "To": "log" },
        { "From": "log", "To": "end" },
        { "From": "none", "To": "end" }
      ]
    }
  ]
}
