{
  // 数据库：DbType 可选 Sqlite / SqlServer / MySql / PostgreSQL / Oracle（SqlSugar 支持的类型）
  "Database": {
    "DbType": "Sqlite",
    "ConnectionString": "Data Source=data/scada.db",
    "RetentionMonths": 12,
    "LogSql": false
  },
  "Security": {
    "MinPasswordLength": 6,
    "RequireDigit": true,
    "RequireLetter": true,
    "PasswordExpireDays": 0,
    "MaxFailedAttempts": 5,
    "LockMinutes": 10,
    "AutoLogoutMinutes": 15,
    "DefaultAdminPassword": "Admin@123",
    // 串口读卡器，如 "COM3"；为空表示使用 HID（键盘模拟）读卡器
    "CardReaderPort": null,
    "CardReaderBaudRate": 9600
  },
  "Mes": {
    "Enabled": true,
    // MES 主动回调监听前缀，如 "http://+:8090/mes/"；为空不启用
    "CallbackPrefix": null,
    "OutboxIntervalSeconds": 30,
    "OutboxMaxRetry": 100
  },
  "Hsl": {
    // HslCommunication 商业授权码，未授权时部分功能有 8 小时限制
    "AuthorizationCode": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
